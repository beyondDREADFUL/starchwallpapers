@model List<NASA>

@{
    ViewData["Title"] = "NASA Astronomy Picture of the Day";
}

<div>
    <h1><img src="~/images/NASA_logo.svg" height="42" style="margin-right: 2px;" alt="NASA" />Astronomy Picture of the Day</h1>
    @if (Model.Count == 0)
    {
        <p class="text-muted">No pictures right now. NASA's picture feed is having problems, so check back later.</p>
    }
    <div>
        @foreach (NASA item in Model)
        {
            <h2>@item.Title</h2>
            <div class="wallpaper-container">
                <div class="wallpaper-wrapper">
                    <a href="@item.Hdimg" target="_blank" rel="noopener"><img src="@item.Thumbnail" alt="@item.Title" height="400" loading="lazy"></a>
                </div>
                <div class="overlay-text"><a href="@item.Hdimg" target="_blank" rel="noopener" style="color: inherit; text-decoration: inherit;">@(item.IsVideo ? "Watch video" : "Download") <img src="~/images/open_link.svg" height="15" style="vertical-align:middle;"></a></div>
            </div>
            <h3>@item.Date</h3>
            <p>@item.Tooltip</p>
            @if (!string.IsNullOrWhiteSpace(item.Copyright))
            {
                <p>Copyright: @item.Copyright</p>
            }
            <br />
        }
    </div>
</div>
